<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Version>0.2.0</Version>
    <Authors>Caique Dourado</Authors>
    <Copyright>Copyright (c) 2026 Caique Dourado</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CaiqueDourado/DedupKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CaiqueDourado/DedupKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>deduplication;record-linkage;entity-resolution;product-matching;portuguese;pt-br;fingerprint;phonetic;gtin;ean</PackageTags>
  </PropertyGroup>
</Project>
